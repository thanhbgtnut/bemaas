# bemaas môi trường dev (L01). Danh sách đầy đủ và giải thích: .env.example ở thư mục gốc.
# Thay mọi giá trị <...> trước khi deploy. Biến để trống dùng mặc định trong config.yaml.

# A. Server
SERVER_ADDR=:8080
SERVER_TIMEZONE=Asia/Ho_Chi_Minh
PLATFORM_ADMINS=<email-quan-tri, cách nhau bằng dấu phẩy>

# B. PostgreSQL
DB_HOST=<db-host>
DB_PORT=5432
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_NAME=bemaas
DB_SSLMODE=disable
DB_MAX_CONNS=10

# C. Redis
REDIS_ADDR=<redis-host>:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=bemaas:

# D. S3 nội bộ (host:port, không có http://)
S3_ENDPOINT=<s3-host>
S3_REGION=us-east-1
S3_BUCKET=bemaas
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>
S3_USE_SSL=true
S3_PATH_STYLE=true
S3_URL_EXPIRY=5m

# E. Keycloak (OIDC)
OIDC_ISSUER=<https://keycloak-host/realms/maas>
OIDC_CLIENT_ID=bemaas-web
OIDC_AUDIENCE=bemaas-web

# F. agentgateway
# Địa chỉ client và Playground (trên trình duyệt) gọi model: host public của Gateway agentgateway-proxy.
GATEWAY_BASE_URL=<http://agentgateway-host>
GATEWAY_KEY_ENV=test
# kubernetes: ghi key, bảng giá, MCP xuống namespace agentgw (cần cicd/tanzu-dev/L01/agentgw/maas-resources.yaml).
GATEWAY_SYNC_MODE=kubernetes
GATEWAY_SYNC_INTERVAL=30s

# G. Kubernetes. bemaas chạy trong cụm (namespace dev-maas) bằng service account của chart,
# được cấp quyền qua RoleBinding maas-key-sync ở agentgw: để trống KUBE_TOKEN, KUBE_CA_DATA.
KUBE_API_SERVER=https://kubernetes.default.svc
KUBE_NAMESPACE=agentgw
KUBE_KEY_CONFIGMAP=maas-keys
KUBE_CATALOG_CONFIGMAP=maas-model-catalog
KUBE_AGW_API_VERSION=agentgateway.dev/v1alpha1
KUBE_MCP_BACKEND=maas-mcp
KUBE_MCP_POLICY=maas-mcp-tools
KUBE_TOKEN=
KUBE_CA_DATA=
KUBE_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# H. Ingester (openssl rand -hex 32). agentgateway xuất access log OTLP tới
# POST http://<bemaas>.dev-maas.svc:8080/ingest/otlp/v1/logs, header Authorization: Bearer <INGEST_TOKEN>.
INGEST_TOKEN=<chuoi-ngau-nhien>
# Tên thuộc tính trong access log, phải khớp frontend.accessLog.attributes của gateway. Để trống dùng mặc định.
INGEST_ATTR_REQUEST_ID=
INGEST_ATTR_KEY_ID=
INGEST_ATTR_DEPT_ID=
INGEST_ATTR_MODEL=
INGEST_ATTR_INPUT_TOKENS=
INGEST_ATTR_CACHE_TOKENS=
INGEST_ATTR_OUTPUT_TOKENS=
INGEST_ATTR_PAGES=
INGEST_ATTR_COST=
INGEST_ATTR_STATUS=
INGEST_ATTR_MCP_TARGET=
INGEST_ATTR_MCP_TOOL=

# I. Job nền
ENFORCER_INTERVAL=1m
MCP_SCAN_INTERVAL=5m

# J. Log: stdout + tệp /logs/bemaas.log (lumberjack), xoay khi đầy 100 MB, giữ 7 ngày
LOG_FILE=/logs/bemaas.log
LOG_MAX_SIZE=100
LOG_MAX_AGE=7
