# =====================================================================
# bemaas: biến môi trường
# ---------------------------------------------------------------------
# 1. Sao chép: cp .env.example .env
# 2. Sửa giá trị cho môi trường của bạn. KHÔNG commit .env.
# 3. configs/config.yaml đọc các biến này qua ${BIẾN}; docker compose ở deploy/ cũng đọc
#    chung tệp này (make up), nên mật khẩu hạ tầng local chỉ khai báo một lần.
#
# Nhóm:
#   A. Server        B. PostgreSQL    C. Redis      D. Kho tệp S3
#   E. Keycloak      F. agentgateway  G. Kubernetes (tài khoản sửa ConfigMap của gateway)
#   H. Ingester (access log OTLP)  I. Job nền  J. Log
# =====================================================================

# ---------------------------------------------------------------------
# A. Server
# ---------------------------------------------------------------------
SERVER_ADDR=:8080
SERVER_TIMEZONE=Asia/Ho_Chi_Minh
# Email được gán Quản trị nền tảng khi đăng nhập lần đầu; cách nhau bằng dấu phẩy.
PLATFORM_ADMINS=admin@maas.local

# ---------------------------------------------------------------------
# B. PostgreSQL
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=bemaas
DB_PASSWORD=bemaas-dev
DB_NAME=bemaas
DB_SSLMODE=disable
DB_MAX_CONNS=10

# ---------------------------------------------------------------------
# C. Redis (cache, khoá phân tán cho job nền)
# ---------------------------------------------------------------------
# Local dùng cổng 6380 để không đụng Redis khác đang chạy trên máy.
REDIS_PORT=6380
REDIS_ADDR=localhost:6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=bemaas:

# ---------------------------------------------------------------------
# D. Kho tệp tương thích S3 (gói skill)
# ---------------------------------------------------------------------
# Local: SeaweedFS trong docker compose. Production: S3 nội bộ của ngân hàng.
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bemaas
S3_ACCESS_KEY=bemaas
S3_SECRET_KEY=bemaas-dev-secret
S3_USE_SSL=false
S3_PATH_STYLE=true
S3_URL_EXPIRY=5m

# ---------------------------------------------------------------------
# E. Keycloak (OIDC)
# ---------------------------------------------------------------------
OIDC_ISSUER=http://localhost:8180/realms/maas
OIDC_CLIENT_ID=bemaas-web
OIDC_AUDIENCE=bemaas-web
# Tài khoản quản trị Keycloak local (chỉ dùng cho docker compose).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# F. agentgateway
# ---------------------------------------------------------------------
# Địa chỉ client gọi model (hiện ở tab API của model card; Playground gọi thẳng địa chỉ này).
# Local: http://localhost:8090 là agentgateway giả của `make devmock`.
GATEWAY_BASE_URL=http://localhost:8090
# live trên production, test trên môi trường thử: key có dạng mk-<live|test>-...
GATEWAY_KEY_ENV=test
# log: chỉ ghi log, không đụng cụm (local). kubernetes: ghi ConfigMap thật.
GATEWAY_SYNC_MODE=log
# Chu kỳ đối soát toàn bộ key; thay đổi key còn được đẩy ngay, không chờ chu kỳ.
GATEWAY_SYNC_INTERVAL=30s

# ---------------------------------------------------------------------
# G. Kubernetes: tài khoản service account `maas-key-sync` để sửa ConfigMap của gateway
#    (quyền get/update/patch trên đúng tên ConfigMap, xem docs/luu-y-trien-khai.md mục 2)
# ---------------------------------------------------------------------
# API server của cụm chạy agentgateway. Trong cụm: https://kubernetes.default.svc
KUBE_API_SERVER=https://kubernetes.default.svc
# Namespace đặt ConfigMap key và bảng giá của gateway.
KUBE_NAMESPACE=agentgateway-system
# Tên ConfigMap tạo sẵn (MaaS không có quyền create).
KUBE_KEY_CONFIGMAP=maas-keys
KUBE_CATALOG_CONFIGMAP=maas-model-catalog
# Tài nguyên MCP (spec mục 20.4): Backend và Policy tạo sẵn, MaaS chỉ sửa spec.
# group/version của CRD phải khớp phiên bản agentgateway đang chạy.
KUBE_AGW_API_VERSION=agentgateway.dev/v1alpha1
KUBE_MCP_BACKEND=maas-mcp
KUBE_MCP_POLICY=maas-mcp-tools
#
# Xác thực, chọn MỘT trong hai cách:
# (1) MaaS chạy NGOÀI cụm: đặt token có thời hạn và CA của API server.
#     kubectl -n agentgateway-system create token maas-key-sync --duration=720h
#     CA lấy từ kubeconfig: trường certificate-authority-data (đã là base64).
KUBE_TOKEN=
KUBE_CA_DATA=
# (2) MaaS chạy TRONG cụm bằng service account maas-key-sync: để trống KUBE_TOKEN, KUBE_CA_DATA;
#     dùng tệp gắn sẵn vào pod (mặc định dưới đây).
KUBE_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# ---------------------------------------------------------------------
# H. Ingester: nhận access log OTLP/HTTP của agentgateway
# ---------------------------------------------------------------------
# Gateway xuất log tới POST http://<bemaas>:8080/ingest/otlp/v1/logs kèm header
# "Authorization: Bearer <INGEST_TOKEN>". Đặt chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
INGEST_TOKEN=dev-ingest-token-doi-ngay
# Tên thuộc tính trong access log. Phải khớp frontend.accessLog.attributes trên cụm; để trống dùng mặc định
# trong config.yaml (request.id, apiKey.key_id, apiKey.dept_id, gen_ai.request.model,
# gen_ai.usage.input_tokens, gen_ai.usage.cache_read_input_tokens, gen_ai.usage.output_tokens,
# agw.ai.usage.pages, agw.ai.usage.cost.total, http.status, mcp.target, mcp.tool.name).
INGEST_ATTR_REQUEST_ID=
INGEST_ATTR_KEY_ID=
INGEST_ATTR_DEPT_ID=
INGEST_ATTR_MODEL=
INGEST_ATTR_INPUT_TOKENS=
INGEST_ATTR_CACHE_TOKENS=
INGEST_ATTR_OUTPUT_TOKENS=
INGEST_ATTR_PAGES=
INGEST_ATTR_COST=
INGEST_ATTR_STATUS=
INGEST_ATTR_MCP_TARGET=
INGEST_ATTR_MCP_TOOL=

# ---------------------------------------------------------------------
# I. Job nền
# ---------------------------------------------------------------------
ENFORCER_INTERVAL=1m
# Quét lại tools/list và kiểm tra kết nối các MCP server.
MCP_SCAN_INTERVAL=5m

# ---------------------------------------------------------------------
# J. Log
# ---------------------------------------------------------------------
# Luôn ghi ra stdout. Đặt LOG_FILE thì ghi thêm vào tệp (thư viện lumberjack): tệp đầy LOG_MAX_SIZE MB
# thì xoay thành bemaas-<thời điểm>.log, tệp đã xoay cũ hơn LOG_MAX_AGE ngày tự bị xoá (0: giữ mãi).
LOG_FILE=
LOG_MAX_SIZE=100
LOG_MAX_AGE=7
